# ==============================================================================
# Vero Platform - Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env`:
#    cp .env.example .env
# 2. Update the credentials below with your real API keys and secrets.
# 3. Never commit the actual `.env` file to version control.
# ==============================================================================

# ==============================================================================
# 1. EMAIL & OTP AUTHENTICATION (SENDGRID SMTP)
# ==============================================================================
# Official Production SendGrid SMTP Setup
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
# SendGrid SMTP username is always the literal text "apikey"
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here
SMTP_FROM_EMAIL=support@veror.website
SMTP_FROM_NAME="App"

# Backup / Testing Personal Gmail SMTP (Optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
# SMTP_FROM_EMAIL=your_email@gmail.com
# SMTP_FROM_NAME="Vero Platform"

# OTP Settings
OTP_TTL_SECONDS=600
SUPERADMIN_EMAIL=superadmin@systemdb.com
SUPERADMIN_DEFAULT_OTP=123456
TEST_OTP_CODES=123456,234567,345678,456789

# AWS SES SMTP (Alternative email provider fallback)
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=your_ses_smtp_user
SES_SMTP_PASSWORD=your_ses_smtp_password
SES_FROM_EMAIL=noreply@yourdomain.com
SES_FROM_NAME="Vero Platform"

# ==============================================================================
# 2. DATABASE CREDENTIALS
# ==============================================================================
# PostgreSQL Credentials
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_DB=saas_db
POSTGRES_PORT=5432
DB_HOST=saas-postgres
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=adminpassword
DB_NAME=saas_db

# MongoDB Credentials (Self-Hosted for Activity Logs)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=adminpassword
MONGODB_DB_NAME=saas_db
MONGODB_URI=mongodb://admin:adminpassword@saas_mongodb:27017/saas_db?authSource=admin

# Redis Credentials
REDIS_HOST=saas-redis
REDIS_PORT=6379
REDIS_URL=redis://saas-redis:6379
REDIS_PASSWORD=change-me-redis

# ==============================================================================
# 3. PAYMENT GATEWAY APIS (Stripe & PayPal)
# ==============================================================================
# Stripe Integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# PayPal Integration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_RETURN_URL=http://localhost:3000/wallet/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3000/wallet/paypal/cancel

# ==============================================================================
# 4. THIRD-PARTY APIS & EXTERNAL INTEGRATIONS
# ==============================================================================
# Exchange Rate API (Currency Service)
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# File Storage Service
FILE_STORAGE_API_KEY=your_file_storage_api_key
FILE_STORAGE_URL=http://localhost:3009

# SMS Gateway (Twilio - for SMS OTP integration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Notification Email Provider (SendGrid - optional alternate)
SENDGRID_API_KEY=

# Sentry / Error Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ==============================================================================
# 5. AUTHENTICATION, JWT & SSO KEYS
# ==============================================================================
NODE_ENV=development
JWT_SECRET=replace_with_strong_32_byte_secret
ACCESS_TOKEN_TTL=604800
REFRESH_TOKEN_TTL=1209600
DEFAULT_CLIENT_ID=first-party-app
DEFAULT_CLIENT_SECRET=replace-me-in-production
ADMIN_BOOTSTRAP_SECRET=change-me-bootstrap
SSO_ISSUER=Vero2Auth

# ==============================================================================
# 6. APPLICATION URLS & GATEWAY ROUTING
# ==============================================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:8001
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Vero"
NEXT_PUBLIC_APP_ENV=development
